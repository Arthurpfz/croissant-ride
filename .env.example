# Optional settings for a hosted copy. Set them in your host's build environment
# (or copy this file to .env); unset ones stay empty.

# The copy's public address, no trailing slash: canonical URL and link previews (og:image).
VITE_SITE_URL=https://example.com
# Legal notice and privacy pages, linked at the foot of the start screen. Unset = no link.
VITE_IMPRESSUM_URL=
VITE_PRIVACY_URL=
